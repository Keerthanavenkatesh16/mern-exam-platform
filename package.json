{
  "name": "secure-digital-assessment-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Digital Assessment Platform (MERN Stack)",
  "main": "backend/server.js",
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js",
    "seed": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
